# ============================================================
# T.A.G.A.P. - Git Ignore Rules
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual Environments ---
venv/
env/
.venv/
ENV/

# --- Environment & Secrets (NEVER COMMIT) ---
.env
.env.local
*.pem
*.key

# --- Database ---
*.db
*.sqlite
*.sqlite3
data/tagap.db

# --- Logs & Runtime ---
logs/
*.log
*.pid

# --- Hardware Configs (machine-specific) ---
config/hardware.local.yaml

# --- IDE & OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Flet Build Artifacts ---
build/
dist/
.flutter-plugins*

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/