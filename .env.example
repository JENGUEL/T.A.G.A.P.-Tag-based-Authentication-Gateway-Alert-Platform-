# ============================================================
# T.A.G.A.P. - Environment Configuration Template
# ============================================================
# Copy this file to ".env" and adjust values for your machine:
#   cp .env.example .env
# NEVER commit the .env file.
# ============================================================

# --- Application ---
TAGAP_ENV=development
TAGAP_APP_NAME=T.A.G.A.P.
TAGAP_VERSION=0.1.0

# --- Hardware Simulation Toggles ---
# Set to "False" when real hardware is connected
USE_MOCK_RFID=True
USE_MOCK_SMS=True

# --- RFID Reader ---
# Windows example:  COM3
# Linux example:    /dev/ttyUSB0
RFID_PORT=COM3
RFID_BAUDRATE=9600
RFID_TIMEOUT_SECONDS=1

# --- GSM Module (SIM800) ---
# Windows example:  COM4
# Linux example:    /dev/ttyUSB1
GSM_PORT=COM4
GSM_BAUDRATE=115200
GSM_TIMEOUT_SECONDS=5

# --- Database ---
DATABASE_URL=sqlite:///data/tagap.db

# --- System Rules ---
DEDUPLICATION_WINDOW_SECONDS=60
CONFIRMATION_TIMEOUT_SECONDS=3
SMS_RETRY_ATTEMPTS=3
SMS_RETRY_BACKOFF_SECONDS=2

# --- Admin ---
# Default admin PIN (change on first run in production)
ADMIN_DEFAULT_PIN=1234

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/tagap.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3